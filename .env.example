# Copy to .env and fill in. Do not commit .env.
# Node 20+ can load this file with:
#   node --env-file=.env server.js
#
# Use the direct Postgres connection or the session pooler (port 5432).
# If the direct host resolves IPv6 only, use the session pooler.
# Do not use the anon key or the transaction pooler (port 6543).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
PGSSLMODE=require
PG_POOL_MAX=5
PG_ADVISORY_LOCK=true
PG_SEED_DEMO=false
# Enable only behind HTTPS (Render production).
# COOKIE_SECURE=true
# Login throttle defaults: 5 failures per email, 15-minute window/lock.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MS=900000
PORT=3000
HOST=0.0.0.0
